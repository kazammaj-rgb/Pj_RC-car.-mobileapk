DEVICE_ID=pirccar-001
FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
FIREBASE_DATABASE_URL=https://YOUR_PROJECT_ID-default-rtdb.firebaseio.com/

# macOS: use the paired HC-06 device shown by `ls /dev/cu.*`.
# Linux: use the paired RFCOMM device, commonly /dev/rfcomm0.
BT_PORT=/dev/cu.HC-06-REPLACE_ME
BT_BAUD=9600
# Optional Bluetooth address/name to serial-port map, JSON encoded.
# Example: BT_DEVICE_PORTS={"00:11:22:33:44:55":"/dev/cu.HC-06"}
BT_DEVICE_NAME=HC-06
BT_DEVICE_PORTS='{}'
HEARTBEAT_SECONDS=2
OPERATOR_TIMEOUT_MS=5000
RECONNECT_INTERVAL_SECONDS=5
FIREBASE_RETRY_SECONDS=5
AUTO_RECONNECT=false
LOG_LEVEL=INFO
